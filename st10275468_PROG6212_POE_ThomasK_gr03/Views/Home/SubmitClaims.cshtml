@model List<st10275468_PROG6212_POE_ThomasK_gr03.Models.Claim>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="\lib\jquery\dist\jquery.js"></script>
    <script src="\lib\jquery-validation\dist\jquery.validate.js"></script>
     <script src="\lib\jquery-validation\dist\additional-methods.js"></script>
    <script src="\lib\jquery-validation-unobtrusive\jquery.validate.unobtrusive.js"></script>

    <style>
        * {
            box-sizing: border-box;
        }
        body {
            background-color: teal;
            color: white;
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
             overflow-x: hidden;
        }

        .container {
            margin: 0 auto;
            width: 100%;
            overflow-x: hidden; 
        }

        .table-container {
            max-height: 450px;
            overflow-y: auto; 
            width: 100%;
        }

      
        table {
            width: 100%;
            border-collapse: collapse;
           
        }

        th, td {
            
            text-align: left;
            
            overflow: hidden;
        }

        th {
            background-color: Black;
            color: white;
        }

        td {
            background-color: #f2f2f2;
            font-size:13px;
        }

        td, th {
            white-space: nowrap;
          
        }


        .row {
            display: flex;
            justify-content: space-between;

            gap: 100px; 
        }

        .form-group {
            margin-bottom: 5px;
        }

        .action-buttons {
            background-color: green;
            color: white;
            border: none;
            padding: 6px 10px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 12px;
            margin-right: 5px;
        }
        button {
            width: 100%;
            padding: 5px;
            background-color: green;
            border-radius: 4px;
            color: white;
            border: none;
           
            font-size: 18px;
            cursor: pointer;
        }

            button:hover {
                background-color: grey;
            }
 .error-message, label.error {
        color: red; 
        font-size: 12px; 
        margin-top: 5px; 
        display: block; 
    }

    .error-in-field {
        border-color: red;
    }
    </style>
   
</head>
<body>
      <h1>Submit and view Claims</h1>
    

   
    <div class="container">
      
        <div class="row">
            <div class="column1">
                <h2>Submit a Claim:</h2>
                <form id="claimForm" method="post" action="@Url.Action("SubmitClaim", "Claim")" enctype="multipart/form-data">
                    <div class="form-group">
                        <label for="month">Claim Month:</label>
                        <input type="month" id="month" name="claimMonth" />
                        <span class="error-message"></span>
                    </div>
                    <div class="form-group">
                        <label for="hoursWorked">Total Hours Worked:</label>
                        <input type="number" id="hoursWorked" name="hoursWorked" oninput="calculateClaimAmount()" />
                         <span class="error-message"></span>
                    </div>
                    <div class="form-group">
                        <label for="hourlyRate">Hourly Rate:</label>
                        <input type="number" id="hourlyRate" name="hourlyRate" oninput="calculateClaimAmount()" />
                        <span class="error-message"></span>
                    </div>
                    <div class="form-group">
                        <label for="totalClaimAmount">Total Claim Amount:</label>
                        <input type="text" id="totalClaimAmount" name="totalClaimAmount" readonly />
                    </div>
                    <div class="form-group">
                        <label for="supportingDocuments">Supporting Documents (optional):</label>
                        <input type="file" id="supportingDocuments" name="supportingDocument" multiple />
                       <span class="error-message"></span>
                    </div>
                    <button type="submit">Submit Claim</button>
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["SuccessMessage"]
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["ErrorMessage"]
                        </div>
                    }
                </form>
            </div>

            <div class="column">
                <h2>View your Claims:</h2>
                <div class="table-container" style="max-height: 450px; overflow-y: auto;">
                    <table>
                        <thead>
                            <tr>
                                <th>Claim ID</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Verification</th>
                                <th>Claim Month</th>
                                <th>Invoices</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!--Looping through the claims and displaying all the specific users claims to them-->
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var claim in Model)
                                {
                                    <tr>
                                        <td>No. @claim.claimID</td>
                                        <td>R @claim.claimAmount</td>
                                        <td>@claim.claimStatus</td>
                                        <td>@claim.claimVerification</td>
                                        <td>@claim.claimMonth.ToString("MMMM yyyy")</td>
                                        <td>
                                            @if (claim.claimStatus == "Processed - Invoice created")
                                            {
                                                <form asp-action="DownloadInvoice" method="get">
                                                    <input type="hidden" name="claimId" value="@claim.claimID" />
                                                    <button type="submit" class="action-buttons">Download Invoice</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5">No claims available.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
 

<script>
  //Using jQuery to validate the inputted claim data live
var $jq = jQuery.noConflict();
$jq(document).ready(function () {
    $jq("#claimForm").validate({
        rules: {
            claimMonth: {
                required: true
            },
            hoursWorked: {
                required: true,
                number: true,
                min: 1
            },
            hourlyRate: {
                required: true,
                number: true,
                min: 1
            },
            supportingDocuments: {
                accept: "application/pdf,image/jpeg,image/png",
                fileSize: 5242880
             }
        },
        messages: {
            claimMonth: {
                required: "Month is required"
            },
            hoursWorked: {
                required: "Total hours is required",
                number: "Invalid number",
                min: "Total hours must be more than 1"
            },
            hourlyRate: {
                required: "Hourly rate is required",
                number: "Invalid number",
                min: "Hourly rate must be more than 1"
            },
            supportingDocuments: {
                accept: "Invalid file format",
                fileSize: "File cannot exceed 5MB in size"
             }

        },
      errorPlacement: function (error, element) {
        error.addClass("error-message");
        error.insertAfter(element); 
    },
    highlight: function (element) {
        $jq(element).addClass("error-in-field"); 
    },
    unhighlight: function (element) {
        $jq(element).removeClass("error-in-field"); 
    },

        submitHandler: function (form) {
            form.submit();
        }
    });
});
       /* Java script method to automatically calculate the total claim amount and update it live to the lecturer*/ 
        function calculateClaimAmount() {
            const hoursWorked = document.getElementById("hoursWorked").value;
            const hourlyRate = document.getElementById("hourlyRate").value;

            if (hoursWorked && hourlyRate) {
                const totalClaimAmount = hoursWorked * hourlyRate;
                document.getElementById("totalClaimAmount").value = totalClaimAmount.toFixed(2); 
            } else {
                document.getElementById("totalClaimAmount").value = ""; 
            }
        }

         



    </script>
</body>
</html>
<!--OpenAI.2024. Chat-GPT(Version 3.5).[Large language model]. Available at: https://chat.openai.com/[Accessed: 9 September 2024].-->