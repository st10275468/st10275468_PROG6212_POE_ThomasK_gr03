@model st10275468_PROG6212_POE_ThomasK_gr03.Models.User

<!DOCTYPE html>
<html lang="en">
<head>
    <style>
        body {
            background-color: teal;
            color: white;
            font-family: Arial, sans-serif;
        }

        .form-container {
            margin-top: 40px;
            margin: 0 auto;
            padding: 20px;
            background-color: white;
            border-radius: 10px;
            width: 30%;
        }

        .form-container label {
            display: block;
            margin-bottom: 5px;
        }

        .form-container input {
            width: 100%;
            padding: 8px;
            margin-bottom: 10px;
                border: 1px solid black;
            border-radius: 2px;
        }

        .form-container button {
            background-color: green;
            color: white;
            border: none;
            padding: 10px;
            cursor: pointer;
            border-radius: 4px;
        }

        .form-container button:hover {
            background-color: teal;
        }
    </style>
</head>
<body>
    <h1 style="margin-bottom:40px;">Edit Lecturer Details</h1>
    <div class="form-container">
        <form asp-action="UpdateLecturerDetails" asp-controller="Home" method="post">
            <input type="hidden" name="userID" value="@Model.userID" />
            <label style="margin-bottom:10px; font-size:20px;">Details of Lecturer:</label>

            <label for="name">Name:</label>
            <input type="text" id="name" name="name" value="@Model.name" />

            <label for="email">Email:</label>
            <input type="email" id="email" name="email" value="@Model.email" />

            <label for="role">Role:</label>
            <input type="text" id="role" name="role" value="@Model.role" readonly />

            <button type="submit">Save Changes</button>
        </form>
    </div>
</body>
</html>
