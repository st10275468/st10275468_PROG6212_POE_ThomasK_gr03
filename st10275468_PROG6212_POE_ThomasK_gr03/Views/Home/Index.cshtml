<!--OpenAI.2024. Chat-GPT(Version 3.5).[Large language model]. Available at: https://chat.openai.com/[Accessed: 20 November 2024].-->
@{
    ViewData["Title"] = "Home Page";
}
<style>
    body {
    background-color: teal;
    }
    .div1 {
        padding-top:20px;
    }
    .h2{
        color: white;
        text-align:left;
    }
    .form-group{
        padding-top:15px;
    }
    .action-buttons {
        background-color: green;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 16px;
        margin-right: 5px;
    }
    
</style>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="path/to/your/styles.css">
</head>

<body>
    <h1 class="h1">Contract Monthly Claim System</h1>

     @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }
    <!--If the user has not logged in it will show them these forms-->
    @if (Context.Session.GetString("Role") == null)
    {

        <div class=" row text-center" style=" margin-left: 100px; padding-right:10px; margin-top: 30px;">

    <div class="col-md-6">
           
                <form id="loginForm" method="post" asp-controller="User" asp-action="Login">
                    <h2>Login:</h2>
                    <div class="form-group">
                        <label for="loginEmail">Email:</label>
                        <input type="email" id="loginEmail" name="email" placeholder="Enter your email address" required />
                    </div>

                    <div class="form-group">
                        <label for="loginPassword">Password:</label>
                        <input type="password" id="loginPassword" name="password" placeholder="Enter your password" required />
                    </div>

                    <div class="form-group">
                        <button type="submit" class="action-buttons">Login</button>
                    </div>
                </form>
                </div>
            
        <div class="col-md-6">
    <form id="createAccountForm" method="post" asp-controller="User" asp-action="Register">
        <h2>Create an Account:</h2>
        <div class="form-group">
            <label for="role">Role:</label>
            <select id="role" name="Role" required>
                <option value="">Select a role</option> 
                <option value="Lecturer">Lecturer</option>
                <option value="Program Coordinator">Program Coordinator</option>
                <option value="Academic Manager">Academic Manager</option>
            </select>
        </div>
        <div class="form-group">
            <label for="name">Name:</label>
            <input type="text" id="name" name="Name" placeholder="Enter your first name" required />
        </div>

        <div class="form-group">
            <label for="surname">Surname:</label>
            <input type="text" id="surname" name="Surname" placeholder="Enter your surname" required />
        </div>

        <div class="form-group">
            <label for="email">Email:</label>
            <input type="email" id="email" name="Email" placeholder="Enter your email address" required />
        </div>

        <div class="form-group">
            <label for="password">Password:</label>
            <input type="password" id="password" name="Password" placeholder="Enter your password" required />
        </div>
        <div class="form-group">
                        <button type="submit" class="action-buttons">Create Account</button>
        </div>
    </form>
</div> 
    </div> }
    <!--If the user's role is a program coordinator or a academic manager they will be shown this form-->
    @if (Context.Session.GetString("Role") == "Program Coordinator" || Context.Session.GetString("Role") == "Academic Manager")
    {
        <div class=" row text-center" style=" margin-left: 100px; padding-right:10px; margin-top: 30px;">

            <div class="role-message">
                <h2 >As a website Admin you can access the following features:</h2>
                
                    <p>> View all pending claims</p>
                    <p>> Approve/Deny pending claims</p>
                    <p>You can access these features by using the navigation bar at the top of the page.</p>
               
            </div>

            <div class="col-md-6">
               
            </div>
        </div>
    }
    <!--If the user's role is a lecturer they will be shown this form-->
    @if (Context.Session.GetString("Role") == "Lecturer")
    {
        <div class=" row text-center" style=" margin-left: 100px; padding-right:10px; margin-top: 30px;">

            <div class="role-message">
                <h2>As a Lecturer, you have access to the following features:</h2>
                
                    <p>> Submit your claims</p>
                    <p>> View & Track your claims</p>
                    <p>You can access these features by using the navigation bar at the top of the page.</p>
            </div>

            <div class="col-md-6">
            </div>
        </div>
    }
    <script>
        setTimeout(function() {
            var successAlert = document.querySelector('.alert-success');
            var errorAlert = document.querySelector('.alert-danger');

            if (successAlert) {
                successAlert.style.display = 'none';
            }
            if (errorAlert) {
                errorAlert.style.display = 'none';
            }
        }, 3000);
    </script>
</body>
</html>

