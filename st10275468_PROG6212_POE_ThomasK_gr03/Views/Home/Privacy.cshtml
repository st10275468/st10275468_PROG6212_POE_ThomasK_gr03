@model List<st10275468_PROG6212_POE_ThomasK_gr03.Models.Claim>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <style>
        body {
            background-color: teal;
            color: white;
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
        }

        .container {
            margin: 0 auto;
            width: 90%;
        }
         .button-container {
            display: flex;
            gap: 5px;
        }
        
        .action-buttons {
            background-color: red;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            margin-right: 5px;
        }
         .action-buttons h3 {
                color: teal;
                margin-bottom: 10px;
            }

            .action-buttons button {
                background-color: teal;
                color: white;
                border: none;
                padding: 4px 8px;
                border-radius: 4px;
                cursor: pointer;
                font-size: 10px;
                margin-right: 5px;
            }

                .action-buttons button:hover {
                    background-color: grey;
                }

       .details-button {
            background-color: green;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
        }

            .details-button:hover {
                background-color: grey;
            }
      
    </style>
</head>
<body>
    <h1>Review all Pending Claims</h1>

    <div class="container">

        <!--Table to show the admins all the pending claims-->
            <div class="claims-table">
            <h2>All pending Claims</h2>
            <div class="table-container" style="max-height: 400px; overflow-y: auto;">
                <table>
                <thead>
                    <tr>
                        <th>Claim ID</th>
                        <th>Lecturer</th>
                        <th>Claim Month</th>
                        <th>Claim Amount</th>
                        <th>Verification</th>
                        <th>Submission Date</th>
                        <th>Documents</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                            <!--Looping through all the claims and displaying the ones with a pending status-->
                        foreach (var claim in Model)
                        {
                            <tr id="claim-row-@claim.claimID">
                                <td>No. @claim.claimID</td>
                                <td>@claim.User.name @claim.User.surname</td>
                                <td>@claim.claimMonth.ToString("MMMM yyyy")</td>
                                <td>R @claim.claimAmount</td>
                                        <td>@claim.claimVerification</td>
                                <td>@claim.submissionDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (claim.Documents != null && claim.Documents.Any())
                                    {
                                            <!--Displaying a download button if there is documents attacthed to specific claimns-->
                                        foreach (var document in claim.Documents)
                                        {
                                            <div>
                                                <form asp-action="DownloadDocument" method="get">
                                                    <input type="hidden" name="documentId" value="@document.documentID" />
                                                    <button type="submit" class="details-button">Download Document</button>
                                                </form>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span>No Documents</span>
                                    }
                                </td>
                                        <td>
                                                <div class="button-container">
                                                    <form asp-action="ApproveClaim" method="post" style="display:inline;">
                                                        <input type="hidden" name="claimID" value="@claim.claimID" />
                                                        <button type="submit" class="details-button approve">Approve</button>
                                                    </form>
                                                    <form asp-action="DenyClaim" method="post" style="display:inline;">
                                                        <input type="hidden" name="claimID" value="@claim.claimID" />
                                                        <button type="submit" class="action-buttons deny">Deny</button>
                                                    </form>
                                                </div>
                                            </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">No claims available.</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
        
    </div>
    <script>
        setTimeout(function() {
            var successAlert = document.querySelector('.alert-success');
            var errorAlert = document.querySelector('.alert-danger');

            if (successAlert) {
                successAlert.style.display = 'none';
            }
            if (errorAlert) {
                errorAlert.style.display = 'none';
            }
        }, 3000);
    </script>
</body>
</html>
<!--OpenAI.2024. Chat-GPT(Version 3.5).[Large language model]. Available at: https://chat.openai.com/[Accessed: 9 September 2024].-->